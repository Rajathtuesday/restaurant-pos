<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen WebView with a branded splash overlay and a first-launch setup overlay -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Splash overlay: shown while WebView loads. Hidden by onPageFinished. -->
    <LinearLayout
        android:id="@+id/splashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#0a0a0a">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#C9A84C"
            android:rotation="45" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="RASOVA"
            android:textColor="#C9A84C"
            android:textSize="18sp"
            android:letterSpacing="0.3"
            android:fontFamily="sans-serif-medium" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            style="?android:attr/progressBarStyle"
            android:indeterminateTint="#C9A84C" />

    </LinearLayout>

    <!-- Setup overlay: shown only on first launch (no URL saved in SharedPreferences).
         Hidden permanently once the user connects or scans a QR. -->
    <LinearLayout
        android:id="@+id/setupView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:background="#0a0a0a"
        android:visibility="gone">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#C9A84C"
            android:rotation="45" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="RASOVA"
            android:textColor="#C9A84C"
            android:textSize="18sp"
            android:letterSpacing="0.3"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Set up your restaurant"
            android:textColor="#888888"
            android:textSize="13sp" />

        <!-- URL input with gold underline -->
        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="your-restaurant.rasova.net"
            android:inputType="textUri"
            android:textColor="#ffffff"
            android:textColorHint="#555555"
            android:textSize="15sp"
            android:background="@null"
            android:paddingBottom="10dp"
            android:imeOptions="actionDone"
            android:singleLine="true" />

        <!-- Gold underline for the input -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="#C9A84C" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CONNECT"
            android:textColor="#0a0a0a"
            android:backgroundTint="#C9A84C"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:onClick="onConnectClicked" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="28dp"
            android:text="— or —"
            android:textColor="#444444"
            android:textSize="12sp" />

        <Button
            android:id="@+id/scanQrButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SCAN QR CODE"
            android:textColor="#C9A84C"
            android:backgroundTint="#1c1c1c"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:onClick="onScanQrClicked" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Scan the QR code from Setup → Printer in your Rasova dashboard"
            android:textColor="#444444"
            android:textSize="11sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

</FrameLayout>
