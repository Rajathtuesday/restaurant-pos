# ═══════════════════════════════════════════════════════
#  Rasova POS: Environment Variables Reference
#  Copy this file to .env and fill in the values.
#  Never commit .env to git.
# ═══════════════════════════════════════════════════════

# ── DEVELOPMENT values shown first, PRODUCTION in comments ──

# ── Core ────────────────────────────────────────────────────
# Dev:  any string works
# Prod: generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-dev-secret-key-here

# Encrypts secrets stored in the DB (e.g. Razorpay key/webhook secrets).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-key-here

# Dev:  True
# Prod: False  ← this one line enables all security settings automatically
DEBUG=True

# Dev:  localhost only
# Prod: rasova.net,www.rasova.net,.rasova.net
ALLOWED_HOSTS=localhost,127.0.0.1

# Dev:  http://localhost:8000
# Prod: https://rasova.net
BASE_URL=http://localhost:8000

# Path to the Django admin login. Defaults to admin/ if unset -- set this
# to something unguessable in production (no leading slash, trailing slash
# required, e.g. ADMIN_URL=xk29-manage/), then restart gunicorn. Every admin
# link reads it and only superusers see one; robots.txt and the service
# worker never name it (core/tests/test_admin_url.py).
ADMIN_URL=admin/

# ── Database ─────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pos_db
DB_USER=pos_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# Dev:  0  (new connection per request: easier to debug)
# Prod: 60 (reuse connections: faster under load)
DB_CONN_MAX_AGE=0

# ── Email ────────────────────────────────────────────────────
# Dev:  prints email to console: no real email sent, no Gmail needed
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_USER=
EMAIL_PASSWORD=

# Prod: remove EMAIL_BACKEND line above and set these:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_USER=rasova.notifications@gmail.com
# EMAIL_PASSWORD=your-gmail-app-password  (not your login password: use App Password)

# ── Claude (Anthropic) API: menu and recipe import ──────────
# Without it the AI is off: pasted text and PDF/Word/Excel menus still go
# through the plain parser, photos and recipes need the key.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: the models (defaults in core/ai_service.py).
# AI_MENU_MODEL=claude-sonnet-5-5
# AI_RECIPE_MODEL=claude-haiku-5-5

# ── Redis + Celery ───────────────────────────────────────────
# Dev:  leave commented: Celery falls back to sync (KOT works, just slower)
# Prod: required: async printing, low stock alerts, etc.
# REDIS_URL=redis://127.0.0.1:6379/0

# ── Sentry (error tracking) ──────────────────────────────────
# Dev:  leave blank
# Prod: paste your DSN from sentry.io
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ── AWS S3 (media file storage) ──────────────────────────────
# Dev:  leave blank: files stored locally in /media/
# Prod: set these to store uploads in S3
# AWS_STORAGE_BUCKET_NAME=rasova-media
# AWS_S3_REGION_NAME=ap-south-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# ── WhatsApp / Twilio ────────────────────────────────────────
# Dev:  leave blank
# Prod: set when WhatsApp receipts are enabled
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# ── Aggregator webhooks (Zomato / Swiggy) ────────────────────
# Dev:  leave as 127.0.0.1
# Prod: set to actual Zomato/Swiggy IP ranges
# AGGREGATOR_IP_ALLOWLIST=127.0.0.1

# ── Client IP (rate limits, login lockouts, allowlist) ──────
# nginx on the same machine; its X-Real-IP is believed only from these.
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# CF-Connecting-IP is believed only from Cloudflare's ranges, built in
# (core/settings.py). Set this only if Cloudflare publishes new ones:
# https://www.cloudflare.com/ips-v4 and /ips-v6
# CLOUDFLARE_IP_RANGES=

# ═══════════════════════════════════════════════════════
#  What changes automatically when DEBUG=False (prod):
#
#  SESSION_COOKIE_SECURE = True    (cookie only over HTTPS)
#  CSRF_COOKIE_SECURE    = True    (CSRF only over HTTPS)
#  SECURE_HSTS_SECONDS   = 31536000 (force HTTPS for 1 year)
#  SECURE_CONTENT_TYPE_NOSNIFF = True
#  CSRF_TRUSTED_ORIGINS set to rasova.net
#
#  You do NOT need to set these manually. Just set DEBUG=False.
# ═══════════════════════════════════════════════════════
