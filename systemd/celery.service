[Unit]
Description=Rasova POS — Celery Worker
After=network.target redis.service

# The worker only runs tasks. Beat (the scheduler) is its own service,
# celery-beat.service, so there is exactly one beat however the worker is
# started. Never add -B here: with celery-beat running too, every scheduled
# job (the 7 am digest, the 6 am invoices) would run twice
# (core/tests/test_server_units.py).
[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rasova
EnvironmentFile=/home/ubuntu/rasova/.env
ExecStart=/home/ubuntu/rasova/.venv/bin/celery \
    -A core worker \
    --queues=default,printing \
    --concurrency=2 \
    --loglevel=warning \
    --logfile=/home/ubuntu/rasova/logs/celery.log
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
